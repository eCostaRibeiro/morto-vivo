{
  "manifest_version": 3,
  "name": "Morto-Vivo",
  "version": "2.48",
  "description": "Descubra se URLs, anúncios e perfis estão vivos, zumbis ou mortos.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/zombie-16.png",
      "32": "icons/zombie-32.png"
    }
  },
  "icons": {
    "16": "icons/zombie-16.png",
    "32": "icons/zombie-32.png",
    "48": "icons/zombie-48.png",
    "128": "icons/zombie-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "debugger"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}